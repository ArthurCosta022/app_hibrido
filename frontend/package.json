{
  "name": "mappin-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "build:web": "expo export --platform web && workbox generateSW workbox-config.js",
    "build:apk": "npx eas-cli build --platform android --profile preview",
    "serve:web": "serve dist --config ../serve.json",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "expo": "^58.0.17",
    "expo-file-system": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.18",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "leaflet": "^1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "serve": "^14.2.6",
    "workbox-cli": "^7.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
