{
  "expo": {
    "name": "MapPin",
    "slug": "mappin-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mappin.app"
    },
    "android": {
      "package": "com.mappin.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "MapPin",
      "shortName": "MapPin",
      "themeColor": "#07122b",
      "backgroundColor": "#07122b"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MapPin to use your location to center the map."
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow MapPin to use the camera to take photos of your places.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#07122b"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "032781ad-cd75-4ae8-95ca-c5832b742a46"
      }
    }
  }
}
